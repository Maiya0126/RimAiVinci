    <PostBuildEvent>REM 设置您的 RimWorld Mod 安装路径 (请根据实际情况修改盘符和路径)
set MOD_DIR="D:\Games\steamapps\common\RimWorld\Mods\MaiyaMod04 Rim AiVinci 边缘智绘芬奇"

REM ========================================================
REM 1. 强制清理 (关键步骤：彻底删除旧文件夹，防止残留)
REM ========================================================
if exist %25MOD_DIR%25\Defs rmdir /s /q %25MOD_DIR%25\Defs
if exist %25MOD_DIR%25\Assemblies rmdir /s /q %25MOD_DIR%25\Assemblies
REM ✨✨ 新增：清理旧的语言包，防止改名后的废弃文件残留 ✨✨
if exist %25MOD_DIR%25\Languages rmdir /s /q %25MOD_DIR%25\Languages

REM 如果您修改了 About 或 Textures，也可以加上下面这两行：
REM if exist %25MOD_DIR%25\About rmdir /s /q %25MOD_DIR%25\About
REM if exist %25MOD_DIR%25\Textures rmdir /s /q %25MOD_DIR%25\Textures

REM ========================================================
REM 2. 复制 DLL (程序集)
REM ========================================================
if not exist %25MOD_DIR%25\Assemblies mkdir %25MOD_DIR%25\Assemblies
copy /y "$(TargetPath)" %25MOD_DIR%25\Assemblies\

REM ========================================================
REM 3. 复制资源文件 (Defs, About, Textures, Languages 等)
REM ========================================================
REM 注意：$(ProjectDir) 是您项目文件的目录。

xcopy /s /y /i "$(ProjectDir)Defs" %25MOD_DIR%25\Defs
xcopy /s /y /i "$(ProjectDir)About" %25MOD_DIR%25\About
xcopy /s /y /i "$(ProjectDir)Textures" %25MOD_DIR%25\Textures

REM ✨✨ 新增：复制语言包 ✨✨
xcopy /s /y /i "$(ProjectDir)Languages" %25MOD_DIR%25\Languages

REM xcopy /s /y /i "$(ProjectDir)Patches" %25MOD_DIR%25\Patches

REM ========================================================
REM 4. 输出完成信息
REM ========================================================
echo [MaiyaMod] 部署完成！Languages 及其他文件已同步。</PostBuildEvent>
